<?xml version='1.0'?>
<!DOCTYPE platform SYSTEM "https://simgrid.org/simgrid.dtd">
<!--
  plataforma_base.xml :: Plataforma SimGrid calibrada del laboratorio
  (1 coordinador + 3 workers).

  Espeja la topología real del Vagrantfile (red privada 192.168.56.0/24,
  todos los nodos en el mismo segmento) con enlaces dedicados par a par
  y routing Full.

  COMO CALIBRAR (tras `vagrant up`):
    1) Velocidad de CPU (speed, en FLOPS):
       Ejecuta `python worker.py --benchmark` en cada VM con el MISMO
       --threads del servicio (ver README 5.1): worker-1 usa --threads 2
       (sus 2 vCPU via pool de procesos; los threads no paralelizan el
       hashing por el GIL) y worker-3 corre DENTRO de su cgroup
       (sudo systemd-run --scope -p CPUQuota=50% ...). Imprime la velocidad
       AGREGADA del nodo en unidades/s. Con "flops per unit" = 1 (default
       de simulacion.py), pon aqui directamente esa cifra (p. ej.
       speed="30.37Mf"). El actor worker del sim ejecuta tareas
       secuencialmente: por eso el speed de worker-1 es la velocidad
       AGREGADA de sus 2 slots, no la per-core.
       Si mantienes las proporciones relativas entre nodos, usa:
         flops_per_unit = velocidad_del_host_simulado / unidades_por_segundo_reales
    2) Latencia (latency): latencia UNIDIRECCIONAL de cada enlace dedicado.
       Equivale al delay que aplica scripts/set_netem.sh (tc netem delay X
       por interfaz, de modo que el RTT de ping resulta 2X). Tras medir con
       `ping` entre VMs, pon latency = RTT_medido / 2 en todos los enlaces.
       (La opcion latency de simulacion.py tambien sobreescribe este valor
       dinamicamente en tiempo de ejecucion.)
    3) Ancho de banda (bandwidth): medir con iperf3 entre VMs. SimGrid espera
       bytes/s: bandwidth = Mbps_medidos / 8 (p. ej. 940 Mbps ~ "117.5MBps").
-->
<platform version="4.1">
  <zone id="cluster-lab" routing="Full">

    <!-- ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
         Hosts: velocidad de CPU calibrable (FLOPS). Perfil heterogéneo
         potente / medio / lento igual que los perfiles del Vagrantfile.
         SUSTITUIR estos valores tras el benchmark de worker.py (cabecera).
         :::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::: -->
    <host id="coordinador" speed="1Gf"/>      <!-- nodo de despacho (no computa) -->
    <!-- Velocidades AGREGADAS medidas (ver cabecera, punto 1): el benchmark
         corre con el mismo --threads del servicio y worker-3 dentro de su
         cgroup (CPUQuota=50%). Los comentarios indican la fecha/medición. -->
    <host id="worker-1"    speed="30.37Mf"/>   <!-- 2 slots (~15.18Mf c/u), medido 2026-11 -->
    <host id="worker-2"    speed="16.26Mf"/>   <!-- 1 slot, medido 2026-11 -->
    <host id="worker-3"    speed="8.89Mf"/>   <!-- 1 slot in-cgroup, medido 2026-11 -->

    <!-- ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
         Enlaces dedicados par a par (una pareja de VMs por enlace, como
         las rutas punto a punto del bridge host-only).
         SUSTITUIR bandwidth/latency tras iperf3 + ping (ver cabecera):
           latency = RTT_ping / 2  (latencia unidireccional por enlace)
         Nota: la opcion latency de simulacion.py sobreescribe estos valores.
         :::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::: -->
    <link id="link-coordinador-worker-1" bandwidth="100Mbps" latency="1ms"/>
    <link id="link-coordinador-worker-2" bandwidth="100Mbps" latency="1ms"/>
    <link id="link-coordinador-worker-3" bandwidth="100Mbps" latency="1ms"/>
    <link id="link-worker-1-worker-2"    bandwidth="100Mbps" latency="1ms"/>
    <link id="link-worker-1-worker-3"    bandwidth="100Mbps" latency="1ms"/>
    <link id="link-worker-2-worker-3"    bandwidth="100Mbps" latency="1ms"/>

    <!-- ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
         Rutas del routing Full. Cada pareja usa su enlace dedicado, asi
         la latencia de un trayecto coordinador a worker es exactamente la
         del enlace (RTT de una consulta STATUS = 2 x latency). Las rutas
         inversas se derivan por simetria (symmetrical=YES por defecto).
         :::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::: -->
    <route src="coordinador" dst="worker-1">
      <link_ctn id="link-coordinador-worker-1"/>
    </route>
    <route src="coordinador" dst="worker-2">
      <link_ctn id="link-coordinador-worker-2"/>
    </route>
    <route src="coordinador" dst="worker-3">
      <link_ctn id="link-coordinador-worker-3"/>
    </route>
    <route src="worker-1" dst="worker-2">
      <link_ctn id="link-worker-1-worker-2"/>
    </route>
    <route src="worker-1" dst="worker-3">
      <link_ctn id="link-worker-1-worker-3"/>
    </route>
    <route src="worker-2" dst="worker-3">
      <link_ctn id="link-worker-2-worker-3"/>
    </route>
  </zone>
</platform>
